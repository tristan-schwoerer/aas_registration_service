# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so

# Git metadata (including nested submodule .git files)
.git/
**/.git/

# Testing
.pytest_cache/
*.coverage
htmlcov/

# IDE
.vscode/
.idea/
*.swp
*.swo

# Temp files
*.tmp
*.log

# Build artifacts of the aas-model submodule: pip would install a stale build/ over the sources
**/build/
**/*.egg-info/
**/.venv/
